# GPT API CONFIGURATION — copy to .env.ai; never put this key in frontend/.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Fill a model ID that your own account can access.
OPENAI_MODEL=
# responses (official OpenAI) OR chat_completions (compatible providers)
AI_API_STYLE=responses
AI_TIMEOUT_SECONDS=60

# Paths are resolved relative to backend/.
FLASH_DATABASE_PATH=data/flash_training_v2.sqlite3
FLASH_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Set true when serving the account API over HTTPS.
FLASH_AUTH_COOKIE_SECURE=false
